{
  "name": "legal-tech-stack",
  "version": "1.0.0",
  "description": "Sistema de automatización legal profesional",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "reporte:ejemplo": "ts-node src/examples/reporte-ejemplo.ts",
    "reporte:9am": "ts-node src/examples/reporte-ejemplo.ts 09:00",
    "reporte:5pm": "ts-node src/examples/reporte-ejemplo.ts 17:00",
    "demo:db": "ts-node src/examples/demo-database.ts",
    "dashboard": "ts-node src/server.ts",
    "dashboard:build": "tsc && node dist/src/server.js",
    "app:completa": "ts-node src/app-completa.ts",
    "app:completa:build": "tsc && node dist/src/app-completa.js"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.5",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.4",
    "pdfkit": "^0.18.0"
  }
}
