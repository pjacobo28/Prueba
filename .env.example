# Google Drive Organizer Configuration
# Copia este archivo a .env y completa con tus valores

# Anthropic API Key - Obtén en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-your-api-key-here

# Google Cloud Project - Opcional si usas service account
# GOOGLE_PROJECT_ID=your-project-id

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Opciones de organización
# Procesar estos tipos de archivo
PROCESS_DOCS=true
PROCESS_SHEETS=true
PROCESS_SLIDES=true
PROCESS_PDF=true

# Tamaño máximo para leer contenido (en caracteres)
MAX_CONTENT_LENGTH=10000

# Número máximo de archivos a procesar por sesión
MAX_FILES_PER_SESSION=100
